#!/bin/sh
# Rotate DSI-1 to follow the accelerometer. Touch follows via map_to_output.
# Sensor "normal" = Duet held landscape with the keyboard cover attached.
# ~/.cache/rotation-lock present = rotation paused.
#
# Ends with the sway that started it (it asks that sway over IPC, SWAYSOCK),
# monitor-sensor included: otherwise each sway restart left another one
# running (duet/duet, two greetd restarts: 2-3 stale copies).
LOCK="$HOME/.cache/rotation-lock"
fifo=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/autorotate.XXXXXX")
mkfifo "$fifo" || exit 1
monitor-sensor --accel >"$fifo" &
sensor=$!
while read -r line; do
  case "$line" in
    *"orientation changed: normal"*)    t=270 ;;
    *"orientation changed: bottom-up"*) t=90 ;;
    *"orientation changed: left-up"*)   t=180 ;;
    *"orientation changed: right-up"*)  t=0 ;;
    *) continue ;;
  esac
  [ -e "$LOCK" ] || swaymsg output DSI-1 transform "$t" >/dev/null
done <"$fifo" &
reader=$!
trap 'kill $sensor $reader 2>/dev/null; rm -f "$fifo"' EXIT
trap 'exit' INT TERM
while kill -0 "$sensor" 2>/dev/null; do
  sleep 5
  swaymsg -t get_version >/dev/null 2>&1 || break
done
