+/* A compositor may hold on to all of our buffers for a while (Qt's does, and
+ * then reads what we write into them: garbled frames). Draw only into a
+ * buffer it has released; every buffer keeps the damage it has missed, so a
+ * frame that has to wait is drawn complete once one comes back. */
+extern void (*wlvncc_buffer_released)(void);
+static bool frame_pending = false;
+
+static bool window_take_free_buffer(struct window* w)
+{
+	for (int i = 0; i < 3; ++i) {
+		int j = (w->buffer_index + i) % 3;
+		if (!w->buffers[j]->is_attached) {
+			w->buffer_index = j;
+			w->back_buffer = w->buffers[j];
+			return true;
+		}
+	}
+	return false;
+}
+
+static void window_present(struct window* w)
+{
+	if (!window_take_free_buffer(w)) {
+		frame_pending = true;
+		return;
+	}
+	frame_pending = false;
+
+	window_attach(w);
+	window_damage_region(w, &w->back_buffer->damage);
+	window_transfer_pixels(w);
+	window_commit(w);
+	window_swap(w);
+}
+
+static void on_buffer_released(void)
+{
+	if (frame_pending && window && window->vnc->n_av_frames == 0)
+		window_present(window);
+}
+
 void on_vnc_client_update_fb(struct vnc_client* client)
 {
 	if (!pixman_region_not_empty(&client->damage) &&
 			client->n_av_frames == 0)
 		return;
 
-	if (window->back_buffer->is_attached)
-		fprintf(stderr, "Oops, back-buffer is still attached.\n");
-
-	window_attach(window);
-
 	struct pixman_region16 frame_damage = { 0 };
 	get_frame_damage(window->vnc, &frame_damage);
-
 	apply_buffer_damage(&frame_damage);
-	window_damage_region(window, &frame_damage);
 	pixman_region_fini(&frame_damage);
 
-	window_transfer_pixels(window);
-
-	window_commit(window);
-	window_swap(window);
+	wlvncc_buffer_released = on_buffer_released;
+	window_present(window);
 }
 
